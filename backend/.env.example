# Local dev: matches `supabase start` output (DB Studio shows the exact URL/ports if they differ).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Hosted Supabase (fill in once the project is created): postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL=

OPENAI_API_KEY=

# From the Twilio Console (Account Info / Messaging > Try it out > WhatsApp sandbox).
# Until these are set, TWILIO_AUTH_TOKEN="" makes every webhook signature check fail
# closed (rejects all requests) — safe default, not a bug.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# Optional internal alerts (approval-needed / delivery-failed) via Gmail SMTP app
# password — https://myaccount.google.com/apppasswords. Unset = silently skipped.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO_EMAIL=
