# Local dev: matches `supabase status` output for this project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hosted Supabase (fill in once the project is created):
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend the dashboard talks to (server-side fetches only, never exposed to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Same backend, but reachable directly from the browser — only used for PDF download
# links (a plain <a> navigation, not fetch/XHR, so no CORS config is needed on the backend).
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
